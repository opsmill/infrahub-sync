# Deny everything, then name what the build needs. Stated this way round, a new
# file at the repository root — a credential, a local override, an editor's
# scratch state — cannot reach the build context by default, and a `COPY .` can
# never pick up more than the list below.
*

!pyproject.toml
!uv.lock
!README.md
!LICENSE.txt
!infrahub_sync
!opsmill_prefect_extras
!frontend

# The web interface's sources, without installed packages or a local build. Of
# the design system submodule, only the one workspace package it uses.
frontend/node_modules
frontend/dist
frontend/vendor/infrahub/*
!frontend/vendor/infrahub/frontend
frontend/vendor/infrahub/frontend/*
!frontend/vendor/infrahub/frontend/packages
frontend/vendor/infrahub/frontend/packages/*
!frontend/vendor/infrahub/frontend/packages/ui
frontend/vendor/infrahub/frontend/packages/ui/node_modules

# Build outputs of the allowed trees; nothing here belongs in an image.
**/__pycache__
**/*.pyc
**/.DS_Store
