# Deny everything, then name what the build needs. Stated this way round, a new
# file at the repository root — a credential, a local override, an editor's
# scratch state — cannot reach the build context by default, and a `COPY .` can
# never pick up more than the list below.
*

!pyproject.toml
!uv.lock
!README.md
!LICENSE.txt
!infrahub_sync
!opsmill_prefect_extras
# The NetBox demo's schema and package, which the wheel carries; only these two
# paths, not the `examples` and `tests` trees around them.
!examples/netbox_to_infrahub/package.yml
!tests/data/nightly_schema/traditional-infrastructure-sot
# The web interface's build inputs, path by path: `!frontend` alone would admit the
# whole 122 MB opsmill/infrahub submodule and a local `node_modules`.
!frontend/.npmrc
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/index.html
!frontend/vite.config.ts
!frontend/tsconfig.json
!frontend/tsr.config.json
!frontend/src
!frontend/vendor/infrahub/frontend/packages/ui

# Build outputs of the allowed trees; nothing here belongs in an image.
**/__pycache__
**/*.pyc
**/.DS_Store
**/node_modules
**/dist
