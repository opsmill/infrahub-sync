.coverage
coverage.xml
*junit*
**/*.pyc
*.env
script.py
**/*.local.*
.vscode/settings.json
node_modules/*
**/.DS_Store
.python-version
**/.ruff_cache
**/.idea/**
.direnv/
.envrc
dist/
.infrahub-sync-cache/
# Local benchmark artifacts
bench-results.csv
.bench-filtered-config.yml
# spec-kit transient download cache (extensions/presets)
.specify/**/.cache/
# spec-kit per-feature working state
.specify/feature.json
# Virtual environments
.venv/
venv/
# Secrets (never commit)
*.pem
*.key
credentials.json
# Container image build outputs: OCI layout, recorded digests, SBOM, scan report.
.image/
.release/
# Preview environment runtime state and local overrides. The shipped defaults
# file must stay tracked despite the repository-wide *.env rule above — it
# contains no secrets and `invoke preview.up` depends on it from a fresh clone.
.preview/
!development/preview.env
development/preview.local.env
# Compose bundle operator state. The shipped defaults are `defaults.conf`
# rather than a `*.env` name so the rule above cannot swallow them; everything
# an operator owns is named here explicitly, because a credential this file
# missed would be a credential the next `git add .` commits.
deploy/compose/operator.env
deploy/compose/secrets/
deploy/compose/.instance
.diagnostics/
