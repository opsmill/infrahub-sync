# Local NetBox environment for the `seed` and `demo` datasets — shipped defaults.
#
# Nothing in this file is a secret: every value only works against the disposable local
# container this stack creates. Never point these values at a shared or internet-facing
# instance.
#
# To change values locally, create development/netbox/netbox.local.env (gitignored) with
# the overrides; the netbox tasks read it after this file.
#
# Keep values UNQUOTED: this file is read both by docker compose --env-file (which strips
# quotes) and by the netbox tasks' plain KEY=VALUE parser (which does not) — a quoted
# value would silently diverge between the two.

# Compose project name isolates this stack's containers, network, and volumes from any
# other NetBox or Infrahub stack on this machine.
COMPOSE_PROJECT_NAME=infrahub-sync-netbox

# Host port. Deliberately avoids 8080 so an existing local Infrahub preview keeps working
# alongside.
NETBOX_PORT=8082

# Public development-default NetBox credentials and secrets, valid only inside this
# disposable container.
NETBOX_DB_PASSWORD=netbox
NETBOX_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef01
NETBOX_TOKEN_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef01
NETBOX_ADMIN_PASSWORD=admin

# The superuser API token, split across a v2 key and plaintext secret (NetBox's
# `SUPERUSER_API_KEY`/`SUPERUSER_API_TOKEN`, exactly 12 and 40 characters). The netbox
# tasks join them into the client-facing token `nbt_<key>.<token>`.
NETBOX_TOKEN_KEY=devnetboxkey
NETBOX_TOKEN=devnetboxseedtoken0000000000000000000000
