# Infrahub Sync preview environment — shipped defaults.
#
# Nothing in this file is a secret: the tokens below only work against the
# disposable local containers the preview creates, and the Infrahub admin token
# is the public development default the official compose file seeds. Never
# point these values at a shared or internet-facing instance.
#
# To change values locally, create development/preview.local.env (gitignored)
# with the overrides; the preview tasks read it after this file.
#
# Keep values UNQUOTED: this file is read both by docker compose --env-file
# (which strips quotes) and by the preview tasks' plain KEY=VALUE parser
# (which does not) — a quoted value would silently diverge between the two.

# Compose project name isolates the preview's containers, network, and volumes
# from any other Infrahub stack on this machine.
COMPOSE_PROJECT_NAME=infrahub-sync-preview
PREVIEW_STORAGE_POSTGRES_PORT=5439
PREVIEW_MINIO_PORT=9010
PREVIEW_S3_BUCKET=infrahub-sync-preview

# Infrahub release the preview runs (image tag interpolated by the official
# compose file). docker-compose.infrahub.yml was downloaded for this version;
# refresh both together.
VERSION=1.10.6

# Host ports. Defaults deliberately avoid 8000/4200 so an existing local
# Infrahub development stack or Prefect server keeps working alongside.
PREVIEW_INFRAHUB_PORT=8080
PREVIEW_PREFECT_PORT=4210
PREVIEW_SYNC_API_PORT=8010

# Prefect image for the dedicated sync-prefect service. Keep in lockstep with
# the prefect pin in pyproject.toml's managed extra.
PREVIEW_PREFECT_IMAGE_TAG=3.8.1-python3.12

# Public development-default admin token seeded by the official compose file.
INFRAHUB_INITIAL_ADMIN_TOKEN=06438eb2-8019-4776-878c-0941b1f1d1ec

# Managed-API principals for the preview (JSON, one line). Local-only values;
# testers minting their own tokens should override in preview.local.env.
PREVIEW_BEARER_TOKENS={"tester@local": {"token": "preview-tester-token-0001", "administrator": true}}

# Prefect work pool the managed deployment targets.
PREVIEW_WORK_POOL=sync-process-pool
